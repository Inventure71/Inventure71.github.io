{
  "name": "inventure71-github-io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:f1": "vite build --config vite.f1-simulator.config.js && node scripts/copy-paddock-placeholder.mjs",
    "sync:chrome": "node scripts/sync-shared-chrome.mjs",
    "check:chrome": "node scripts/sync-shared-chrome.mjs --check",
    "test": "npm run test:f1",
    "test:f1": "vitest run tests --exclude \"tests/browser/**\"",
    "check": "npm run check:chrome && npm run check:styles && npm run check:metadata && npm run check:portfolio && npm run check:resume && npm run check:agents && npm run test && npm run build:f1",
    "sync:styles": "node scripts/sync-route-styles.mjs",
    "check:styles": "node scripts/sync-route-styles.mjs --check",
    "sync:metadata": "node scripts/sync-metadata.mjs",
    "check:metadata": "node scripts/sync-metadata.mjs --check",
    "test:browser": "playwright test",
    "sync:portfolio": "node scripts/sync-portfolio.mjs",
    "check:portfolio": "node scripts/sync-portfolio.mjs --check",
    "sync:resume": "node scripts/sync-resume.mjs",
    "check:resume": "node scripts/sync-resume.mjs --check",
    "sync:agents": "node scripts/sync-agent-content.mjs",
    "check:agents": "node scripts/sync-agent-content.mjs --check"
  },
  "dependencies": {
    "@inventure71/paddockjs": "4.3.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "vite": "8.2.4",
    "vitest": "4.1.12"
  }
}
